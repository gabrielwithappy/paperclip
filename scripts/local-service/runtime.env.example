# Copy to ~/.config/paperclip/local-service/runtime.env (chmod 600).
# Put the absolute Node executable in node-path beside it. Use Node dotenv syntax.
PAPERCLIP_HOME=/absolute/private/paperclip-home
PAPERCLIP_INSTANCE_ID=default
PAPERCLIP_CONFIG=/absolute/private/paperclip-home/instances/default/config.json
DATABASE_URL=postgres://paperclip:REPLACE@127.0.0.1:55432/paperclip
HOST=0.0.0.0
PORT=3110
PAPERCLIP_DEPLOYMENT_MODE=authenticated
PAPERCLIP_DEPLOYMENT_EXPOSURE=private
PAPERCLIP_BIND=lan
PAPERCLIP_AUTH_BASE_URL_MODE=explicit
PAPERCLIP_PUBLIC_URL=https://PRIVATE_BOARD_ORIGIN
PAPERCLIP_API_URL=http://HOST_REACHABLE_FROM_RUNTIME:3110
PAPERCLIP_CHAT_WEBHOOK_PUBLIC_URL=https://PUBLIC_CALLBACK_ORIGIN
PAPERCLIP_ALLOWED_HOSTNAMES=PUBLIC_CALLBACK_HOST,LAN_HOST,DOCKER_GATEWAY
BETTER_AUTH_TRUSTED_ORIGINS=http://localhost:3110,http://127.0.0.1:3110
# Copy existing values. Do not generate replacements during migration.
BETTER_AUTH_SECRET=REPLACE_WITH_EXISTING
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=REPLACE_WITH_EXISTING
PAPERCLIP_AGENT_JWT_SECRET=REPLACE_WITH_EXISTING
TZ=Asia/Seoul
