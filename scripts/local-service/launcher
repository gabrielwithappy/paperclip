#!/bin/bash
set -euo pipefail

# Keep the pinned interpreter and secrets outside the checkout. No shell eval.
config_dir="${PAPERCLIP_LOCAL_CONFIG_DIR:-${XDG_CONFIG_HOME:-$HOME/.config}/paperclip/local-service}"
IFS= read -r node_binary < "$config_dir/node-path"
[[ "$node_binary" = /* && -x "$node_binary" ]] || { echo 'Invalid pinned Node executable' >&2; exit 1; }
script_dir="$(cd -- "$(dirname -- "${BASH_SOURCE[0]}")" && pwd)"
exec "$node_binary" --env-file="$config_dir/runtime.env" "$script_dir/entry.mjs" "$@"
