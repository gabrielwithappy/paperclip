# Copy to docker/.env.private-slack and set real values; keep that file untracked.
# Use separate `openssl rand -hex 32` values for each secret. The database
# password must be hex because it is also interpolated into a PostgreSQL URL.
PAPERCLIP_DB_PASSWORD=REPLACE_WITH_HEX_PASSWORD
BETTER_AUTH_SECRET=REPLACE_WITH_SESSION_SECRET
PAPERCLIP_TOOL_ACTION_SIGNING_SECRET=REPLACE_WITH_ACTION_SECRET

# A private HTTPS address reachable by the operator's browser, such as Tailscale Serve.
PAPERCLIP_PUBLIC_URL=https://paperclip.your-tailnet.ts.net
# An HTTP origin reachable from agent containers. The default Docker bridge gateway
# is suitable when Paperclip publishes PAPERCLIP_BOARD_PORT on the host.
PAPERCLIP_API_URL=http://172.17.0.1:3110
# Public HTTPS origin served by Cloudflare Tunnel; no path or trailing slash.
PAPERCLIP_CHAT_WEBHOOK_PUBLIC_URL=https://slack-hook.example.com
PAPERCLIP_ALLOWED_HOSTNAMES=slack-hook.example.com,172.17.0.1

# Host loopback ports. 3110 can coexist with a local Paperclip service on 3100.
PAPERCLIP_BOARD_PORT=3110
PAPERCLIP_CALLBACK_PORT=3111
